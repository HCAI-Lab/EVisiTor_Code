;;; ============================================================================
;;; Model-generated Subtask chunks for 8 Windows tasks selected from the
;;; PSAI computer-use dataset (huggingface.co/datasets/anaisleila/computer-use-data-psai)
;;;
;;; Generated by: Claude (Fable 5), 2026-07-06, from the task instructions and
;;; the vendors' reasoning_steps, WITHOUT seeing any human-authored chunks.
;;; Purpose: comparison baseline. The modeler will hand-author gold chunks for
;;; the same tasks later; score these against them with the Appendix G
;;; procedure (schema validity, subtask coverage, action-verb accuracy,
;;; target accuracy, exact match).
;;;
;;; Schema (identical to the paper):
;;;   (chunk-type Subtask actions items)
;;;   Action vocabulary: Goto, Move, Select, Type, Press
;;;   Normalized executable form:
;;;   (setq subtaskT_S_list '((Verb "Target") (Verb "Target") (end|endsub)))
;;;
;;; Vocabulary notes (deviations forced by Windows-native tasks, see
;;; selected_tasks.md):
;;;   * Press targets may be modifier combos ("win+r", "ctrl+shift+esc", ...)
;;;   * Right-click is expressed within-vocabulary as Select + Press "shift+f10"
;;;   * Labels marked #VERIFY-UIA must be checked against the live UIA tree
;;; ============================================================================

;;; ----------------------------------------------------------------------------
;;; W1  (EASY, Run dialog)  cmaela4ed001gzr0xhfhqg921
;;; "Use the Run dialog (Win+R) to open Notepad on Windows."
;;; ----------------------------------------------------------------------------
(setq subtaskW1_1_list '((Press "win+r") (end)))
(setq subtaskW1_2_list '((Type "notepad") (Press "enter") (end)))
(setq subtaskW1_3_list '((Goto "Close") (Select "Close") (endsub)))          ; #VERIFY-UIA "Close" button of Notepad window

;;; ----------------------------------------------------------------------------
;;; W2  (EASY, File Explorer)  cmaela4el00dezr0xar3kk07l
;;; "Rename the file 'budget.xlsx' to 'budget_2025.xlsx' using File Explorer."
;;; ----------------------------------------------------------------------------
(setq subtaskW2_1_list '((Goto "budget.xlsx") (Select "budget.xlsx") (end)))
(setq subtaskW2_2_list '((Goto "Rename") (Select "Rename") (end)))           ; #VERIFY-UIA command-bar Rename button
(setq subtaskW2_3_list '((Type "budget_2025.xlsx") (Press "enter") (endsub)))

;;; ----------------------------------------------------------------------------
;;; W3  (EASY, File Explorer)  cm9egbfne005d0e0v3a0rw2pb
;;; "Create a new folder named 'Projects' on the Desktop using File Explorer."
;;; ----------------------------------------------------------------------------
(setq subtaskW3_1_list '((Goto "Desktop") (Select "Desktop") (end)))         ; navigation-pane item
(setq subtaskW3_2_list '((Press "ctrl+shift+n") (end)))                      ; New Folder shortcut (within-vocabulary alternative to right-click > New > Folder)
(setq subtaskW3_3_list '((Type "Projects") (Press "enter") (endsub)))

;;; ----------------------------------------------------------------------------
;;; W4  (MEDIUM, File Explorer)  cmaela4el00dgzr0xvj1od7q9
;;; "Compress the folder 'Logs' into a ZIP archive."
;;; ----------------------------------------------------------------------------
(setq subtaskW4_1_list '((Goto "Logs") (Select "Logs") (end)))
(setq subtaskW4_2_list '((Press "shift+f10") (end)))                         ; open context menu on selection
(setq subtaskW4_3_list '((Goto "Show more options") (Select "Show more options") (end)))  ; #VERIFY-UIA Win11 legacy-menu item
(setq subtaskW4_4_list '((Goto "Send to") (Select "Send to") (end)))
(setq subtaskW4_5_list '((Goto "Compressed (zipped) folder") (Select "Compressed (zipped) folder") (end)))  ; #VERIFY-UIA
(setq subtaskW4_6_list '((Press "enter") (endsub)))                          ; accept default archive name "Logs.zip"

;;; ----------------------------------------------------------------------------
;;; W5  (EASY, Windows Settings)  cma092ib300e6wu0v1mk0doaw
;;; "Adjust the screen resolution in Windows to 1920x1080 via Settings."
;;; ----------------------------------------------------------------------------
(setq subtaskW5_1_list '((Press "win+i") (end)))
(setq subtaskW5_2_list '((Goto "System") (Select "System") (end)))
(setq subtaskW5_3_list '((Goto "Display") (Select "Display") (end)))
(setq subtaskW5_4_list '((Goto "Display resolution") (Select "Display resolution") (end)))  ; #VERIFY-UIA dropdown label
(setq subtaskW5_5_list '((Goto "1920 × 1080") (Select "1920 × 1080") (end)))               ; #VERIFY-UIA: multiplication sign, not letter x
(setq subtaskW5_6_list '((Goto "Keep changes") (Select "Keep changes") (end)))
(setq subtaskW5_7_list '((Goto "Close") (Select "Close") (endsub)))

;;; ----------------------------------------------------------------------------
;;; W6  (MEDIUM, Task Manager)  cmaela4ef004uzr0xjcxi49z5
;;; "Open Task Manager on Windows and end a running process."
;;; Target process parameterized; "Notepad" used as the example instance.
;;; ----------------------------------------------------------------------------
(setq subtaskW6_1_list '((Press "ctrl+shift+esc") (end)))
(setq subtaskW6_2_list '((Goto "Notepad") (Select "Notepad") (end)))         ; any non-required running app
(setq subtaskW6_3_list '((Goto "End task") (Select "End task") (endsub)))    ; #VERIFY-UIA lowercase "task"

;;; ----------------------------------------------------------------------------
;;; W7  (MEDIUM, Command Prompt)  cmaela4em00ggzr0xbdq9jgok
;;; "Use Command Prompt to find your IP address (using ipconfig)."
;;; ----------------------------------------------------------------------------
(setq subtaskW7_1_list '((Press "win") (end)))                               ; open Start / search
(setq subtaskW7_2_list '((Type "cmd") (Press "enter") (end)))
(setq subtaskW7_3_list '((Type "ipconfig") (Press "enter") (end)))
(setq subtaskW7_4_list '((Goto "IPv4 Address") (endsub)))                    ; pure visual search: locate the IPv4 line in the output

;;; ----------------------------------------------------------------------------
;;; W8  (HARD, Microsoft Excel)  cm9qi2tb9004zx60wq4sez68x
;;; "Create a macro to sort multiple columns simultaneously."
;;; Sort keys follow the vendor demonstration: Department, then Employee Name.
;;; Vendor upload steps (PSAI portal) are excluded as data-collection overhead.
;;; ----------------------------------------------------------------------------
(setq subtaskW8_1_list  '((Goto "View") (Select "View") (end)))
(setq subtaskW8_2_list  '((Goto "Macros") (Select "Macros") (end)))
(setq subtaskW8_3_list  '((Goto "Record Macro") (Select "Record Macro") (end)))
(setq subtaskW8_4_list  '((Goto "Macro name") (Select "Macro name") (end)))
(setq subtaskW8_5_list  '((Type "MultiColumnSort") (end)))
(setq subtaskW8_6_list  '((Goto "OK") (Select "OK") (end)))
(setq subtaskW8_7_list  '((Goto "A1") (Select "A1") (end)))                  ; anchor of the data range
(setq subtaskW8_8_list  '((Press "ctrl+shift+end") (end)))                   ; extend selection to full range (drag not in vocabulary)
(setq subtaskW8_9_list  '((Goto "Data") (Select "Data") (end)))
(setq subtaskW8_10_list '((Goto "Sort") (Select "Sort") (end)))
(setq subtaskW8_11_list '((Goto "Sort by") (Select "Sort by") (end)))
(setq subtaskW8_12_list '((Goto "Department") (Select "Department") (end)))
(setq subtaskW8_13_list '((Goto "Add Level") (Select "Add Level") (end)))
(setq subtaskW8_14_list '((Goto "Then by") (Select "Then by") (end)))
(setq subtaskW8_15_list '((Goto "Employee Name") (Select "Employee Name") (end)))
(setq subtaskW8_16_list '((Goto "OK") (Select "OK") (end)))
(setq subtaskW8_17_list '((Goto "View") (Select "View") (end)))
(setq subtaskW8_18_list '((Goto "Macros") (Select "Macros") (end)))
(setq subtaskW8_19_list '((Goto "Stop Recording") (Select "Stop Recording") (endsub)))

