;;; --- Task 1: W01 (Run dialog, EASY)
;;; Use the Run dialog (Win+R) to open Notepad on Windows.
;;; PSAI unique_data_id: cmaela4ed001gzr0xhfhqg921
(setq subtask1_1_list '((Press "win+r") (end)))
(setq subtask1_2_list '((Type "notepad") (Press "enter") (end)))
(setq subtask1_3_list '((Goto "Close") (Select "Close") (endsub)))

;;; --- Task 2: W02 (File Explorer, EASY)
;;; Rename the file 'budget.xlsx' to 'budget_2025.xlsx' using File Explorer.
;;; PSAI unique_data_id: cmaela4el00dezr0xar3kk07l
(setq subtask2_1_list '((Goto "budget.xlsx") (Select "budget.xlsx") (end)))
(setq subtask2_2_list '((Goto "Rename") (Select "Rename") (end)))
(setq subtask2_3_list '((Type "budget_2025.xlsx") (Press "enter") (endsub)))

;;; --- Task 3: W03 (File Explorer, EASY)
;;; Create a new folder named 'Projects' on the Desktop using File Explorer.
;;; PSAI unique_data_id: cm9egbfne005d0e0v3a0rw2pb
(setq subtask3_1_list '((Goto "File Explorer") (Select "File Explorer") (end)))
(setq subtask3_2_list '((Goto "Desktop") (Select "Desktop") (end)))
(setq subtask3_3_list '((Goto "Desktop background") (RightClick "Desktop background") (end)))
(setq subtask3_4_list '((Goto "New") (Select "New") (Goto "Folder") (Select "Folder") (end)))
(setq subtask3_5_list '((Type "Projects") (Press "enter") (endsub)))

;;; --- Task 4: W04 (File Explorer, MEDIUM)
;;; Compress the folder 'Logs' into a ZIP archive.
;;; PSAI unique_data_id: cmaela4el00dgzr0xvj1od7q9
(setq subtask4_1_list '((Goto "Logs") (RightClick "Logs") (end)))
(setq subtask4_2_list '((Goto "Show more options") (Select "Show more options") (end)))
(setq subtask4_3_list '((Goto "Send to") (Select "Send to") (Goto "Compressed (zipped) folder") (Select "Compressed (zipped) folder") (end)))
(setq subtask4_4_list '((Press "enter") (endsub)))

;;; --- Task 5: W07 (Command Prompt, MEDIUM)
;;; Use Command Prompt to find your IP address (using ipconfig).
;;; PSAI unique_data_id: cmaela4em00ggzr0xbdq9jgok
(setq subtask5_1_list '((Goto "Search") (Select "Search") (end)))
(setq subtask5_2_list '((Type "cmd") (Press "enter") (end)))
(setq subtask5_3_list '((Type "ipconfig") (Press "enter") (end)))
(setq subtask5_4_list '((Scroll "down") (Goto "IPv4 Address") (endsub)))

;;; --- Task 6: W09 (Start menu, EASY)
;;; Open the Calculator via the Windows Start menu search bar.
