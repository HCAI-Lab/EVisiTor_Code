(setq subtask6_1_list '((Goto "Search") (Select "Search") (end)))
(setq subtask6_2_list '((Type "calculator") (Press "enter") (end)))
(setq subtask6_3_list '((Goto "Calculator") (endsub)))

;;; --- Task 7: W10 (File Explorer (Windows search), EASY)
;;; Search for a file named 'report.docx' in the Documents folder using Windows search.
;;; PSAI unique_data_id: cm9egbkl7005j0e0v774e8iqr
(setq subtask7_1_list '((Goto "File Explorer") (Select "File Explorer") (end)))
(setq subtask7_2_list '((Goto "Documents") (Select "Documents") (end)))
